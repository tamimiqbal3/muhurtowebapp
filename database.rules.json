{
  "rules": {
    "site": {
      "version": { ".read": true, ".write": false }
    },
    "presence": {
      ".read": "auth != null && auth.token.admin === true",
      ".indexOn": ["at"],
      "$sid": {
        ".write": "$sid.length >= 8 && $sid.length <= 40",
        ".validate": "newData.hasChildren(['path', 'at', 'device']) && newData.child('path').isString() && newData.child('path').val().length <= 200 && newData.child('at').isNumber() && (newData.child('device').val() === 'mobile' || newData.child('device').val() === 'desktop')"
      }
    },
    "adminFeed": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false,
      ".indexOn": ["at"]
    },
    "bookings": { ".indexOn": ["customerId", "status", "createdAt"] },
    "payments": { ".indexOn": ["bookingId", "status", "customerId", "createdAt"] },
    "users": { ".indexOn": ["email", "createdAt"] },
    "notifications": { ".indexOn": ["userId", "createdAt"] },
    "customizationRequests": { ".indexOn": ["customerId", "status", "createdAt"] },
    "eventUpdates": { ".indexOn": ["bookingId", "createdAt"] },
    "monitoringAgents": { ".indexOn": ["active"] },
    "monitoringAssignments": { ".indexOn": ["agentId", "bookingId", "eventDate"] },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
