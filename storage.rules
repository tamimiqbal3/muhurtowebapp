rules_version = '2';

// All uploads go through the server (Admin SDK) after the admin session is checked:
//   /api/site/upload  → site/<yyyy-mm>/<uuid>.<ext>   (photos for services, homepage, logos…)
// Browsers may read those images; nobody can write directly from the browser.
service firebase.storage {
  match /b/{bucket}/o {
    match /site/{month}/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /services/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
