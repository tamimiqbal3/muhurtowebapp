# ─── Site ────────────────────────────────────────────────────────────────
# Public base URL (used for payment callback URLs and SEO). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Firebase (client SDK — these are public identifiers, not secrets) ──
# The muhurto-app web config is built in (src/lib/config.ts). Set these only to point at another project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin (server only — SECRET) ───────────────────────────────
# From Firebase console → Project settings → Service accounts → Generate new private key.
# REQUIRED for Firebase mode (catalogue, admin edits, accounts, bookings, payments, invoices).
# Easiest: put the WHOLE downloaded key file in FIREBASE_SERVICE_ACCOUNT (raw JSON or base64).
# Or use the three variables below. Without either, the site runs in local-storage mode.
# Set them in Vercel → Settings → Environment Variables (Production), then redeploy.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=muhurto-app
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Comma-separated emails that are promoted to admin on first sign-in.
ADMIN_EMAILS=

# Catalog source: "auto" (Realtime Database once published, else bundled data)
# or "demo" (always bundled data).
CATALOG_SOURCE=auto

# ─── Gemini (server only — SECRET) ───────────────────────────────────────
GEMINI_API_KEY=
# Change the model without touching code.
GEMINI_MODEL=gemini-2.5-flash

# ─── SSLCommerz (server only — SECRET) ───────────────────────────────────
# Sandbox credentials: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" uses sandbox.sslcommerz.com. Set to "false" only with live credentials.
SSLCOMMERZ_SANDBOX=true

# ─── Monitoring agents ───────────────────────────────────────────────────
# "true" = after payment, automatically assign the active agent with the
# fewest active events (matching the event city when possible).
# "false" = an admin assigns agents manually from /admin/bookings.
AUTO_ASSIGN_MONITORING_AGENT=false
