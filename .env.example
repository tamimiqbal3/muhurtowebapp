# ─── Site ────────────────────────────────────────────────────────────────
# Public base URL (used for payment callback URLs and SEO). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Firebase (client SDK — these are public identifiers, not secrets) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (server only — SECRET) ───────────────────────────────
# From Firebase console → Project settings → Service accounts → Generate key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Comma-separated emails that are promoted to admin on first sign-in.
ADMIN_EMAILS=

# Catalog source: "auto" (Firestore if seeded, else bundled demo data),
# "firestore" (always Firestore) or "demo" (always bundled demo data).
CATALOG_SOURCE=auto

# ─── Gemini (server only — SECRET) ───────────────────────────────────────
GEMINI_API_KEY=
# Change the model without touching code.
GEMINI_MODEL=gemini-2.5-flash

# ─── SSLCommerz (server only — SECRET) ───────────────────────────────────
# Sandbox credentials: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" uses sandbox.sslcommerz.com. Set to "false" only with live credentials.
SSLCOMMERZ_SANDBOX=true

# ─── Monitoring agents ───────────────────────────────────────────────────
# "true" = after payment, automatically assign the active agent with the
# fewest active events (matching the event city when possible).
# "false" = an admin assigns agents manually from /admin/bookings.
AUTO_ASSIGN_MONITORING_AGENT=false
